PORT=7000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kbtc_pr
DB_USER=root
DB_PASSWORD=rootpassword

# เปลี่ยนเป็นค่าสุ่มยาวๆ ก่อนขึ้นระบบจริง
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=8h

# คั่นด้วย , ถ้ามีหลายโดเมน (เว้นว่าง = อนุญาตทุกโดเมน)
CORS_ORIGIN=http://localhost:3000
UPLOAD_MAX_MB=20
